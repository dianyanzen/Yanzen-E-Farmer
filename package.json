{
  "name": "yanzen-e-farmer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test && npm run typecheck && npm run test:game && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/database.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:game": "node tests/game-canonical-roster-assets.mjs && node tests/game-private-residents.mjs && node tests/game-npc-separation.mjs && node tests/game-stage1.mjs && node tests/game-life.mjs && node tests/game-save.mjs && node tests/game-living-world.mjs && node tests/game-bandung-world.mjs && node tests/game-phaser-prototype.mjs && node tests/game-asset-database.mjs && node tests/game-asset-categories.mjs && node tests/game-humanizer-skill.mjs && node tests/game-character-bible.mjs && node tests/game-phone-story.mjs && node scripts/game-narrative/audit-game-copy.mjs && node tests/game-public-catalog.mjs && node scripts/game-characters/check-portrait-enrichment.mjs && node scripts/deploy/vercel-game-playtest.mjs --check",
    "test:game:ui": "node tests/game-chapter1-ui.mjs",
    "assets:audit": "node scripts/game-assets/verify-catalog.mjs",
    "assets:fetch:crops": "node scripts/game-assets/fetch-cc0-crops.mjs",
    "test:game:life:ui": "node tests/game-life-ui.mjs",
    "test:portraits": "node tests/game-portraits.mjs",
    "test:portraits:ui": "node tests/game-portraits-ui.mjs",
    "test:world": "node tests/game-bandung-world.mjs",
    "test:game:phaser": "node tests/game-phaser-prototype.mjs",
    "assets:index": "node scripts/game-assets/build-asset-database.mjs",
    "assets:index:check": "node scripts/game-assets/build-asset-database.mjs --check",
    "assets:search": "node scripts/game-assets/query-asset-database.mjs",
    "assets:sqlite": "python3 scripts/game-assets/export-asset-sqlite.py",
    "test:game:assets": "node tests/game-asset-database.mjs && node tests/game-asset-categories.mjs",
    "assets:quality": "node scripts/game-assets/report-asset-quality.mjs",
    "assets:categories": "node scripts/game-assets/build-asset-categories.mjs",
    "assets:categories:check": "node scripts/game-assets/build-asset-categories.mjs --check",
    "test:game:humanizer": "node tests/game-humanizer-skill.mjs",
    "chars:index": "node scripts/game-characters/build-character-index.mjs",
    "chars:index:check": "node scripts/game-characters/build-character-index.mjs --check",
    "test:game:characters": "node tests/game-character-bible.mjs",
    "test:game:phone": "node tests/game-phone-story.mjs",
    "test:game:copy": "node scripts/game-narrative/audit-game-copy.mjs",
    "chars:roster:check": "node scripts/game-characters/check-private-roster.mjs",
    "chars:bible:seed": "node scripts/game-characters/seed-private-bibles.mjs",
    "build:vercel:game-playtest": "npm run test && npm run typecheck && npm run test:game && node scripts/deploy/vercel-game-playtest.mjs --apply && next build",
    "chars:bible:audit": "node scripts/game-characters/audit-private-bibles.mjs",
    "chars:bible:audit:strict": "node scripts/game-characters/audit-private-bibles.mjs --strict",
    "chars:bible:install": "node scripts/game-characters/install-private-bibles.mjs",
    "chars:public:check": "node scripts/game-characters/verify-public-catalog.mjs && node scripts/game-characters/build-public-wiki.mjs --check",
    "chars:public:wiki": "node scripts/game-characters/build-public-wiki.mjs",
    "chars:portrait:check": "node scripts/game-characters/check-portrait-enrichment.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.6",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
