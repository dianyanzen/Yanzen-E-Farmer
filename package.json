{
  "name": "yz-farm-life",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:database:game && npm run test:game && next build",
    "start": "next start",
    "lint": "eslint src/app/api src/app/game src/app/login src/app/layout.game.tsx src/app/page.game.tsx src/lib/game src/lib/local-auth tests/game-postgres.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/database.mjs",
    "test:database:game": "node tests/game-postgres.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:game": "node tests/game-stage1.mjs && node tests/game-life.mjs && node tests/game-save.mjs && node tests/game-living-world.mjs && node tests/game-bandung-world.mjs && node scripts/game-world/verify-toolkit.mjs && node tests/game-published-residents.mjs && node tests/game-docker-resident-bibles.mjs && npm run test:game:phaser",
    "test:game:ui": "node tests/game-chapter1-ui.mjs",
    "assets:audit": "node scripts/game-assets/verify-catalog.mjs",
    "assets:fetch:crops": "node scripts/game-assets/fetch-cc0-crops.mjs",
    "test:game:life:ui": "node tests/game-life-ui.mjs",
    "test:portraits": "node tests/game-portraits.mjs",
    "test:portraits:ui": "node tests/game-portraits-ui.mjs",
    "test:world": "node tests/game-bandung-world.mjs",
    "tools:tiled:export": "node scripts/game-world/export-tiled.mjs",
    "tools:tiled:check": "node scripts/game-world/export-tiled.mjs --check",
    "tools:github:check": "node scripts/game-world/verify-toolkit.mjs",
    "test:game:phaser": "node tests/game-phaser-prototype.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.16.3",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
